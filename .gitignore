# ============================================================
# SentinelX-SIEM — .gitignore
# Reglas completas para evitar comitear datos sensibles o temporales.
# ============================================================

# ---------- Entorno y Credenciales ----------
.env
.env.*
!.env.example
.envrc
agent/sentinelx-agent.env

# ---------- Python / Virtualenv ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# ---------- Bases de datos SQLite y Temporales ----------
*.db
*.sqlite
*.sqlite3
sentinelx_dev.db

# ---------- Testing y Cobertura ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ---------- Frontend (Node / Astro) ----------
node_modules/
dist/
.astro/
.cache/
.turbo/
.vercel/
.netlify/
.output/
front/node_modules/
front/dist/
front/.astro/
front/.cache/
front/.output/

# ---------- Logs y Datos de Ejecución ----------
*.log
logs/
/var/log/sentinelx/
uploads/
uploaded_logs/
raw_logs/
spool/
states/
reports/generated/
/tmp/

# ---------- Backups y Dumps SQL ----------
backups/
*.sql
*.sql.gz
*.dump
*.bak
*.backup

# ---------- Comprimidos e Imágenes de Prueba ----------
*.gz
*.tgz
*.zip
!*.example.zip
screenshots/
*.png
*.jpg
*.jpeg

# ---------- Alembic ----------
alembic/versions/*.pyc
alembic/versions/__pycache__/

# ---------- Docker autogenerado ----------
docker-compose.yml
docker-compose.override.yml
!docker-compose.example.yml

# ---------- IDE y Sistema Operativo ----------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
