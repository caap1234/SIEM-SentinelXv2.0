[Unit]
Description=SentinelX SIEM - Core REST API Service
After=network.target postgresql.service opensearch.service minio.service nats.service
Wants=postgresql.service

[Service]
Type=simple
User=sentinelx
Group=sentinelx
WorkingDirectory=/opt/sentinelx
EnvironmentFile=/opt/sentinelx/.env
ExecStart=/opt/sentinelx/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
