[Unit]
Description=SentinelX SIEM - Log Pipeline Ingestion Worker Service
After=network.target postgresql.service opensearch.service nats.service sentinelx-api.service
Wants=sentinelx-api.service

[Service]
Type=simple
User=sentinelx
Group=sentinelx
WorkingDirectory=/opt/sentinelx
EnvironmentFile=/opt/sentinelx/.env
ExecStart=/opt/sentinelx/.venv/bin/python -m app.services.log_pipeline
Restart=always
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
