# ============================================================
# SentinelX-SIEM — Plantilla de Configuración de Entorno (.env)
# Copiar este archivo a '.env' y ajustar las credenciales antes de iniciar.
# ============================================================

# ---------- PostgreSQL (Base de Datos SOC) ----------
POSTGRES_DB=sentinelx_db
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=Cambiar_Esta_Contrasena_Segura_2026!
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinelx:Cambiar_Esta_Contrasena_Segura_2026!@localhost:5432/sentinelx_db

# ---------- Backend FastAPI ----------
SECRET_KEY=Generar_Una_Clave_Secreta_Aleatoria_De_At_Least_32_Caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=480
INTERNAL_JOBS_TOKEN=3104df6291c5a93c6e426afcce2eaa1f20de519ab0098640173da24c6a64bcef
BACKEND_PORT=8000

# ---------- Admin Inicial ----------
INITIAL_ADMIN_EMAIL=admin@empresa.com
INITIAL_ADMIN_PASSWORD=Cambiar_Admin_Password_2026!
INITIAL_ADMIN_FULL_NAME=Administrador SOC SentinelX

# ---------- OpenSearch (Eventos y Analítica) ----------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# ---------- NATS JetStream (Pipeline de Ingesta) ----------
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MGMT_PORT=8222

# ---------- MinIO / S3 (Evidencias y Archivos Generados) ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sentinelx-evidence
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Directorios y Rutas de Datos ----------
UPLOADED_LOGS_DIR=/opt/sentinelx/uploaded_logs
GEOIP_COUNTRY_DB_PATH=/opt/sentinelx/geoip/GeoLite2-Country.mmdb
GEOIP_ASN_DB_PATH=/opt/sentinelx/geoip/GeoLite2-ASN.mmdb

# ---------- Configuración de Reglas y Caché ----------
ENRICH_INLINE=1
ENRICH_CACHE_TTL=86400
ENRICH_CACHE_MAX=100000
RULES_RELOAD_SECONDS=60

# ---------- Workers y Motor de Detección ----------
WORKER_POLL_SECONDS=2
WORKER_MAX_PER_CYCLE=1
WORKER_STALE_SECONDS=3600
ENGINE_WORKER_POLL_SECONDS=1
ENGINE_WORKER_MAX_PER_CYCLE=200
ENGINE_WORKER_STALE_SECONDS=3600

# ---------- Configuración SMTP (Opcional - Notificaciones por Correo) ----------
