# SentinelX SIEM - Configuración de Caché para Apache / LiteSpeed / cPanel
# Forzar la entrega de archivos HTML frescos sin caché en el navegador ni servidor web
<FilesMatch "\.(html|htm)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</FilesMatch>
