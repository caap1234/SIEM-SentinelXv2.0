---
export interface Props {
  label: string;
  value: string;
  helper?: string;
  /** clave para mapear contra el JSON, ej: "critical_threats" */
  statKey?: string;
}

const { label, value, helper, statKey } = Astro.props;
---

<div
  class="rounded-xl bg-white border border-[#E5E7EB] p-5 flex flex-col justify-between h-full shadow-sm gap-2"
  data-stat-key={statKey || ""}
>
  <span
    class="text-[11px] font-semibold text-[#6B7280] uppercase tracking-wider truncate"
    data-stat-label
  >
    {label}
  </span>

  <span
    class="text-2xl font-bold text-[#111827] tracking-tight my-0.5"
    data-stat-value
  >
    {value}
  </span>

  {helper && (
    <span class="text-[11px] text-[#9CA3AF] font-normal" data-stat-helper>
      {helper}
    </span>
  )}
</div>

