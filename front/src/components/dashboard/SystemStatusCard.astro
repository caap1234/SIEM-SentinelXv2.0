---
const API_BASE = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8000"
---


<div class="rounded-xl bg-white border border-[#E5E7EB] p-6 shadow-sm flex flex-col">
  <!-- TÍTULO -->
  <div class="text-center mb-2">
    <h2 class="text-sm font-semibold text-[#111827]">
      Estado del sistema
    </h2>
    <p class="text-xs text-[#6B7280] mt-1">
      Componentes clave del motor de SentinelX (ingesta, correlación, alertas).
    </p>
  </div>

  <!-- GRID -->
  <div class="w-full mt-4">
    <!-- Encabezados -->
    <div class="grid grid-cols-4 pb-3 border-b border-[#E5E7EB] text-xs font-medium text-[#6B7280]">
      <div class="text-left pl-1">Componente</div>
      <div class="text-center">Estado</div>
      <div class="text-left">Detalle</div>
      <div class="text-center">Indicador</div>
    </div>

    <!-- Filas dinámicas -->
    <div class="text-xs divide-y divide-[#F3F4F6]" data-system-status>
      <!-- Inyectado desde JSON -->
    </div>
  </div>

  <script>
    import { getDashboardSummary } from "../../lib/dashboard.js";

    const container = document.querySelector("[data-system-status]");

    const COLOR_MAP = {
      healthy: "#22C55E", // verde
      degraded: "#F59E0B", // amarillo
      offline: "#DC2626", // rojo
      unknown: "#9CA3AF", // gris
    };

    function renderStatus(healthObj) {
      if (!container) return;
      container.innerHTML = "";

      const components = [
        { name: "API Control Plane", key: "api", detail: "FastAPI Stateful Services" },
        { name: "NATS JetStream", key: "nats", detail: "Broker & Streaming Engine" },
        { name: "OpenSearch Cluster", key: "opensearch", detail: "Data Streams & Indexers" },
        { name: "MinIO S3 Evidence", key: "minio", detail: "Gzip & Hash Verification" },
        { name: "PostgreSQL DB", key: "postgresql", detail: "Transactional & Audit Engine" },
      ];

      components.forEach((c) => {
        const state = healthObj[c.key] || "unknown";
        const row = document.createElement("div");
        row.className = "grid grid-cols-4 py-3 items-center";

        const comp = document.createElement("div");
        comp.className = "pl-1 text-[#111827] font-medium";
        comp.textContent = c.name;

        const status = document.createElement("div");
        status.className = "text-center text-[#4B5563] capitalize";
        status.textContent = state;

        const detail = document.createElement("div");
        detail.className = "text-left text-[#6B7280]";
        detail.textContent = c.detail;

        const indicatorBox = document.createElement("div");
        indicatorBox.className = "flex justify-center";

        const pill = document.createElement("div");
        pill.className =
          "inline-flex items-center gap-1 px-2 py-1 rounded-full bg-[#F9FAFB] border border-[#E5E7EB]";

        const dot = document.createElement("span");
        dot.className = "h-2.5 w-2.5 rounded-full";
        dot.style.backgroundColor = COLOR_MAP[state] || COLOR_MAP.unknown;

        const label = document.createElement("span");
        label.className = "text-[10px] text-[#4B5563]";
        label.textContent =
          state === "healthy"
            ? "Estable"
            : state === "degraded"
            ? "Atención"
            : state === "offline"
            ? "Crítico"
            : "Desconocido";

        pill.append(dot, label);
        indicatorBox.append(pill);

        row.append(comp, status, detail, indicatorBox);
        container.append(row);
      });
    }

    async function loadSystemStatus() {
      if (!container) return;

      try {
        const summary = await getDashboardSummary();
        renderStatus(summary.system_health || {});
      } catch (err) {
        console.error("Error al cargar estado del sistema SIEM:", err);
        renderStatus({});
      }
    }

    loadSystemStatus();
    setInterval(loadSystemStatus, 15000); // Polling configurable cada 15 segundos
  </script>

</div>
