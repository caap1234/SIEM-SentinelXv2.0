---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import HeaderBar from "../../components/dashboard/HeaderBar.astro";

const API_BASE = import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8000";
---

<DashboardLayout pageTitle="SentinelX SIEM – Reportes SOC">
  <HeaderBar
    title="Reportes SOC"
    subtitle="Genera informes de seguridad profesional (Ejecutivos, Operativos, Tendencias y Expedientes)."
    showFilters={false}
  />

  <section class="flex-1 px-8 py-6 space-y-6">

    <!-- PANEL DE GENERACIÓN DE REPORTES -->
    <div class="rounded-xl bg-white border border-[#E5E7EB] shadow-sm overflow-hidden">
      <div class="px-8 py-4 border-b border-[#E5E7EB] flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold text-[#111827]">
            Generador de Informes de Seguridad
          </h2>
          <p class="text-xs text-[#6B7280] mt-0.5">
            Selecciona la plantilla, el rango de tiempo y el formato deseado.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7ED] text-[#EA580C] text-[11px] font-semibold border border-[#FFEDD5]">
          Plantillas Oficiales
        </span>
      </div>

      <div class="px-8 py-6 space-y-6">
        <form id="generateReportForm" class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="md:col-span-2 space-y-1">
            <label class="block text-xs font-semibold text-[#111827]">Tipo de Reporte</label>
            <select id="reportType" class="h-10 w-full rounded-lg border border-[#D1D5DB] bg-white px-3 text-xs font-semibold text-[#111827] focus:ring-2 focus:ring-[#F97316]">
              <option value="executive_weekly">Ejecutivo Semanal (Dirección)</option>
              <option value="executive_monthly">Ejecutivo Mensual (Comparativa)</option>
              <option value="executive_quarterly">Ejecutivo Trimestral (Estratégico)</option>
              <option value="soc_operational" selected>Operativo SOC (Analistas & SLAs)</option>
              <option value="trends">Reporte de Tendencias</option>
              <option value="incident_report">Expediente Individual de Incidente</option>
            </select>
          </div>

          <div class="space-y-1">
            <label class="block text-xs font-semibold text-[#111827]">Formato de Salida</label>
            <select id="reportFormat" class="h-10 w-full rounded-lg border border-[#D1D5DB] bg-white px-3 text-xs font-semibold text-[#111827] focus:ring-2 focus:ring-[#F97316]">
              <option value="pdf" selected>PDF (Formato Oficial)</option>
              <option value="html">HTML (Interactivo / Impresión)</option>
              <option value="json">JSON (Estructurado)</option>
              <option value="csv">CSV (Datos Planos)</option>
            </select>
          </div>

          <div class="space-y-1">
            <label class="block text-xs font-semibold text-[#111827]">Rango de Tiempo</label>
            <select id="reportDays" class="h-10 w-full rounded-lg border border-[#D1D5DB] bg-white px-3 text-xs font-semibold text-[#111827] focus:ring-2 focus:ring-[#F97316]">
              <option value="7" selected>Últimos 7 días</option>
              <option value="30">Últimos 30 días</option>
              <option value="90">Últimos 90 días</option>
              <option value="180">Últimos 180 días</option>
              <option value="365">Año completo (365 días)</option>
            </select>
          </div>
        </form>

        <div class="flex items-center justify-between pt-3 border-t border-[#E5E7EB]">
          <span id="generateStatus" class="text-xs text-[#6B7280]"></span>
          <button id="generateBtn" type="button" class="h-10 px-6 rounded-lg bg-[#F97316] text-white text-xs font-bold hover:bg-[#EA580C] shadow-sm">
            Generar Reporte
          </button>
        </div>
      </div>
    </div>

    <!-- PREVISUALIZACIÓN DE REPORTE -->
    <div id="previewBox" class="hidden rounded-xl bg-white border border-[#E5E7EB] shadow-sm overflow-hidden">
      <div class="px-8 py-4 border-b border-[#E5E7EB] flex items-center justify-between bg-[#F9FAFB]">
        <h3 class="text-sm font-semibold text-[#111827]">Previsualización del Reporte</h3>
        <div class="flex gap-2">
          <a id="downloadPreviewBtn" href="#" target="_blank" class="h-8 px-4 rounded-md bg-[#1E293B] text-white text-xs font-semibold flex items-center gap-1.5 hover:bg-[#0F172A]">
            Descargar Archivo
          </a>
          <button id="closePreviewBtn" type="button" class="h-8 px-3 rounded-md border border-[#D1D5DB] bg-white text-xs font-semibold hover:bg-[#F3F4F6]">
            Cerrar
          </button>
        </div>
      </div>
      <div class="p-6 bg-[#F8FAFC]">
        <iframe id="previewIframe" class="w-full h-[600px] border border-[#E2E8F0] rounded-lg bg-white shadow-inner"></iframe>
      </div>
    </div>

    <!-- HISTORIAL DE REPORTES GENERADOS (METADATOS POSTGRESQL + S3) -->
    <div class="rounded-xl bg-white border border-[#E5E7EB] shadow-sm overflow-hidden">
      <div class="px-8 py-4 border-b border-[#E5E7EB] flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold text-[#111827]">
            Historial de Reportes Generados
          </h2>
          <p class="text-xs text-[#6B7280] mt-0.5">
            Metadatos en PostgreSQL con almacenamiento binario en MinIO S3.
          </p>
        </div>
        <button id="refreshReportsBtn" type="button" class="h-8 px-3 rounded-md border border-[#D1D5DB] bg-white text-xs font-semibold text-[#374151] hover:bg-[#F3F4F6]">
          Actualizar
        </button>
      </div>

      <div class="px-8 py-4 overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-[#E5E7EB] text-[#6B7280] uppercase text-[10px] font-bold">
              <th class="py-3 pr-4">ID</th>
              <th class="py-3 pr-4">Tipo de Reporte</th>
              <th class="py-3 pr-4">Formato</th>
              <th class="py-3 pr-4">Creado Por</th>
              <th class="py-3 pr-4">Fecha Generación</th>
              <th class="py-3 pr-4">Almacenamiento (S3)</th>
              <th class="py-3 text-right">Acción</th>
            </tr>
          </thead>
          <tbody id="reportsTbody">
            <tr><td colspan="7" class="py-4 text-[#9CA3AF]">Cargando historial de reportes…</td></tr>
          </tbody>
        </table>
      </div>
    </div>

  </section>

  <script type="module" define:vars={{ API_BASE }}>
    const getToken = () =>
      localStorage.getItem("sentinelx_token") ||
      sessionStorage.getItem("sentinelx_token") ||
      "";

    if (!getToken()) window.location.href = "/login";

    const authHeaders = () => ({
      Authorization: `Bearer ${getToken()}`,
      Accept: "application/json",
      "Content-Type": "application/json",
    });

    const reportTypeSelect = document.getElementById("reportType");
    const reportFormatSelect = document.getElementById("reportFormat");
    const reportDaysSelect = document.getElementById("reportDays");
    const generateBtn = document.getElementById("generateBtn");
    const generateStatus = document.getElementById("generateStatus");

    const previewBox = document.getElementById("previewBox");
    const previewIframe = document.getElementById("previewIframe");
    const downloadPreviewBtn = document.getElementById("downloadPreviewBtn");
    const closePreviewBtn = document.getElementById("closePreviewBtn");

    const reportsTbody = document.getElementById("reportsTbody");
    const refreshReportsBtn = document.getElementById("refreshReportsBtn");

    // Cargar Historial
    async function loadReportsHistory() {
      try {
        const res = await fetch(`${API_BASE}/api/v1/reports`, { headers: authHeaders() });
        if (!res.ok) {
          reportsTbody.innerHTML = '<tr><td colspan="7" class="py-4 text-[#DC2626]">No se pudo cargar el historial.</td></tr>';
          return;
        }

        const data = await res.json();
        const items = data.items || [];

        if (items.length === 0) {
          reportsTbody.innerHTML = '<tr><td colspan="7" class="py-4 text-[#9CA3AF]">No se han generado reportes aún.</td></tr>';
          return;
        }

        reportsTbody.innerHTML = items.map(r => `
          <tr class="border-b border-[#E5E7EB] hover:bg-[#F9FAFB]">
            <td class="py-3 font-semibold text-[#111827]">#${r.id}</td>
            <td class="py-3 font-medium text-[#111827]">${formatReportTypeName(r.type)}</td>
            <td class="py-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase ${r.format === 'pdf' ? 'bg-[#FEE2E2] text-[#DC2626]' : 'bg-[#DBEAFE] text-[#1D4ED8]'}">${r.format}</span></td>
            <td class="py-3 text-[#6B7280]">${r.created_by}</td>
            <td class="py-3 text-[#6B7280]">${new Date(r.created_at).toLocaleString()}</td>
            <td class="py-3 font-mono text-[10px] text-[#059669]">${r.storage_path || 'MinIO S3'}</td>
            <td class="py-3 text-right">
              <a href="${API_BASE}/api/v1/reports/${r.id}/download?token=${encodeURIComponent(getToken() || '')}" target="_blank" class="px-3 py-1 rounded bg-[#F97316] text-white text-[11px] font-semibold hover:bg-[#EA580C]">
                Descargar
              </a>
            </td>
          </tr>
        `).join("");

      } catch (err) {
        console.error(err);
        reportsTbody.innerHTML = '<tr><td colspan="7" class="py-4 text-[#DC2626]">Error de red al consultar reportes.</td></tr>';
      }
    }

    function formatReportTypeName(type) {
      const names = {
        executive_weekly: "Ejecutivo Semanal",
        executive_monthly: "Ejecutivo Mensual",
        executive_quarterly: "Ejecutivo Trimestral",
        soc_operational: "Operativo SOC",
        trends: "Tendencias de Seguridad",
        incident_report: "Expediente de Incidente"
      };
      return names[type] || type;
    }

    // Generar Reporte
    generateBtn.addEventListener("click", async () => {
      const type = reportTypeSelect.value;
      const format = reportFormatSelect.value;
      const days = parseInt(reportDaysSelect.value, 10);

      generateBtn.disabled = true;
      generateStatus.textContent = "Compilando métricas y generando reporte en MinIO S3…";

      try {
        const res = await fetch(`${API_BASE}/api/v1/reports/generate`, {
          method: "POST",
          headers: authHeaders(),
          body: JSON.stringify({ type, format, days })
        });

        if (!res.ok) {
          const errText = await res.text();
          generateStatus.textContent = `Error: ${errText}`;
          generateBtn.disabled = false;
          return;
        }

        const report = await res.json();
        generateStatus.textContent = `Reporte #${report.id} generado exitosamente.`;
        generateBtn.disabled = false;

        // Mostrar previsualización si es HTML/PDF
        const dlUrl = `${API_BASE}/api/v1/reports/${report.id}/download?token=${encodeURIComponent(getToken() || '')}`;
        downloadPreviewBtn.href = dlUrl;
        previewIframe.src = dlUrl;
        previewBox.classList.remove("hidden");


        loadReportsHistory();

      } catch (err) {
        console.error(err);
        generateStatus.textContent = "Error de conexión al generar reporte.";
        generateBtn.disabled = false;
      }
    });

    closePreviewBtn.addEventListener("click", () => {
      previewBox.classList.add("hidden");
    });

    refreshReportsBtn.addEventListener("click", loadReportsHistory);

    // Carga Inicial
    loadReportsHistory();
  </script>
</DashboardLayout>
