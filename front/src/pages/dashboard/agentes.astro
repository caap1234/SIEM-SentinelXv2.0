---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import HeaderBar from "../../components/dashboard/HeaderBar.astro";
---

<DashboardLayout pageTitle="SentinelX SIEM – Gestión de Agentes Linux">
  <HeaderBar
    title="Gestión de Agentes Linux"
    subtitle="Monitoreo de telemetría e ingesta activa de servidores Linux conectados (cPanel, CloudLinux, AlmaLinux, Ubuntu)."
    showFilters={false}
  />

  <section class="flex-1 px-8 py-6 space-y-6">
    <!-- CARDS KPI DE ESTADO DE AGENTES -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="rounded-2xl border border-[#E5E7EB] bg-white p-5 shadow-sm">
        <p class="text-xs uppercase font-semibold text-[#6B7280]">Agentes Saludables</p>
        <p class="text-2xl font-bold text-[#10B981] mt-1" data-kpi-healthy>0</p>
        <p class="text-[11px] text-[#9CA3AF] mt-1">Heartbeat &lt; 5 min</p>
      </div>

      <div class="rounded-2xl border border-[#E5E7EB] bg-white p-5 shadow-sm">
        <p class="text-xs uppercase font-semibold text-[#6B7280]">Heartbeat Retrasado</p>
        <p class="text-2xl font-bold text-[#F59E0B] mt-1" data-kpi-delayed>0</p>
        <p class="text-[11px] text-[#9CA3AF] mt-1">Heartbeat 5 - 30 min</p>
      </div>

      <div class="rounded-2xl border border-[#E5E7EB] bg-white p-5 shadow-sm">
        <p class="text-xs uppercase font-semibold text-[#6B7280]">Desconectados (Offline)</p>
        <p class="text-2xl font-bold text-[#EF4444] mt-1" data-kpi-offline>0</p>
        <p class="text-[11px] text-[#9CA3AF] mt-1">Sin reporte &gt; 30 min</p>
      </div>

      <div class="rounded-2xl border border-[#E5E7EB] bg-white p-5 shadow-sm">
        <p class="text-xs uppercase font-semibold text-[#6B7280]">Total Registrados</p>
        <p class="text-2xl font-bold text-[#111827] mt-1" data-kpi-total>0</p>
        <p class="text-[11px] text-[#9CA3AF] mt-1">En el tenant activo</p>
      </div>
    </div>

    <!-- BARRA DE BÚSQUEDA Y FILTROS DE AGENTES -->
    <div class="rounded-2xl border border-[#E5E7EB] bg-white p-6 shadow-sm flex flex-col md:flex-row gap-3 items-center justify-between">
      <div class="flex flex-col md:flex-row gap-3 items-center w-full md:w-auto flex-1">
        <input
          type="text"
          placeholder="Buscar por hostname de servidor (ej. srv-cpanel-01)..."
          class="h-10 px-4 rounded-full border border-[#D1D5DB] text-xs text-[#111827] w-full md:w-80 focus:outline-none focus:ring-2 focus:ring-[#E67E22]/70"
          data-agents-search
        />

        <select class="h-10 px-4 rounded-full border border-[#D1D5DB] text-xs text-[#111827] bg-white focus:outline-none focus:ring-2 focus:ring-[#E67E22]/70" data-agents-status-select>
          <option value="">Todos los Estados</option>
          <option value="healthy">Saludables (Healthy)</option>
          <option value="delayed">Retrasados (Delayed)</option>
          <option value="offline">Desconectados (Offline)</option>
        </select>
      </div>

      <button type="button" class="h-10 px-5 rounded-full bg-[#E67E22] text-white text-xs font-medium hover:bg-[#D35400] transition flex items-center gap-2" data-agents-refresh>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        <span>Actualizar Estado</span>
      </button>

    </div>

    <!-- TABLA SOC DE AGENTES -->
    <div class="rounded-2xl border border-[#E5E7EB] bg-white shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-[#E5E7EB] flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold text-[#111827]">Agentes Linux Registrados</h2>
          <p class="text-xs text-[#6B7280]" data-agents-summary>Consultando agentes...</p>

        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-xs">
          <thead>
            <tr class="bg-[#FAFAFB] text-[#6B7280] border-b border-[#E5E7EB]">
              <th class="py-3 px-4 text-left">Hostname / Servidor</th>
              <th class="py-3 px-4 text-left">IP Registrada</th>
              <th class="py-3 px-4 text-left">Sistema Operativo</th>
              <th class="py-3 px-4 text-center">Versión Agente</th>
              <th class="py-3 px-4 text-left">Último Heartbeat</th>
              <th class="py-3 px-4 text-center">Estado</th>
              <th class="py-3 px-4 text-center">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#F3F4F6] text-[#374151]" data-agents-table-body>
            <!-- Filas dinámicas -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- MODAL DETALLE DE TELEMETRÍA DEL AGENTE -->
    <div id="agent-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden place-items-center p-4">
      <div class="w-full max-w-3xl max-h-[90vh] bg-white rounded-2xl shadow-xl flex flex-col overflow-hidden">
        <div class="px-6 py-4 border-b border-[#E5E7EB] flex justify-between items-center bg-[#FAFAFB]">
          <h3 class="text-sm font-semibold text-[#111827]">Telemetría y Estado del Agente Linux</h3>
          <button type="button" class="text-xs text-[#6B7280] hover:text-[#111827]" data-agent-modal-close>✕ Cerrar</button>
        </div>

        <div class="p-6 space-y-4 overflow-y-auto">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 bg-[#F9FAFB] p-4 rounded-xl border border-[#E5E7EB] text-xs">
            <div><span class="text-[#9CA3AF] block font-semibold">Agent ID:</span><code data-modal-agent-id class="text-[11px] font-mono break-all">—</code></div>
            <div><span class="text-[#9CA3AF] block font-semibold">Hostname:</span><strong data-modal-agent-host class="text-[#111827]">—</strong></div>
            <div><span class="text-[#9CA3AF] block font-semibold">Versión:</span><span data-modal-agent-ver>—</span></div>
            <div><span class="text-[#9CA3AF] block font-semibold">Estado:</span><span data-modal-agent-status class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold">HEALTHY</span></div>
          </div>

          <div class="space-y-2">
            <h4 class="text-xs font-semibold text-[#111827]">Información del Sistema Operativo</h4>
            <div class="bg-[#F9FAFB] p-3 rounded-xl border border-[#E5E7EB] text-xs space-y-1">
              <p><strong class="text-[#6B7280]">OS:</strong> <span data-modal-agent-os>—</span></p>
              <p><strong class="text-[#6B7280]">IP:</strong> <span data-modal-agent-ip>—</span></p>
              <p><strong class="text-[#6B7280]">Metadata Adicional:</strong> <code data-modal-agent-meta class="text-[11px] font-mono">—</code></p>
            </div>
          </div>

          <div class="space-y-2">
            <h4 class="text-xs font-semibold text-[#111827]">Últimos Eventos de Check-in Telemétrico</h4>
            <div class="bg-[#111827] text-[#34D399] p-4 rounded-xl text-[11px] font-mono overflow-x-auto max-h-48" data-modal-agent-events>
              Cargando registros...
            </div>
          </div>
        </div>

        <div class="px-6 py-3 border-t border-[#E5E7EB] flex justify-end bg-[#FAFAFB]">
          <button type="button" class="px-4 py-2 rounded-full border border-[#D1D5DB] text-[12px] text-[#374151] hover:bg-[#F3F4F6]" data-agent-modal-close>
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck
    import { apiGet } from "../../lib/api.js";

    const kpiHealthy = document.querySelector("[data-kpi-healthy]");
    const kpiDelayed = document.querySelector("[data-kpi-delayed]");
    const kpiOffline = document.querySelector("[data-kpi-offline]");
    const kpiTotal = document.querySelector("[data-kpi-total]");

    const tbody = document.querySelector("[data-agents-table-body]");
    const summaryEl = document.querySelector("[data-agents-summary]");
    const searchInput = document.querySelector("[data-agents-search]");
    const statusSelect = document.querySelector("[data-agents-status-select]");
    const refreshBtn = document.querySelector("[data-agents-refresh]");

    const modal = document.getElementById("agent-modal");
    const modalCloseBtns = document.querySelectorAll("[data-agent-modal-close]");

    const STATUS_BADGES = {
      healthy: "bg-[#DCFCE7] text-[#166534]",
      delayed: "bg-[#FEF3C7] text-[#92400E]",
      offline: "bg-[#FEE2E2] text-[#991B1B]",
    };

    let allAgents = [];

    async function loadAgents() {
      if (!tbody) return;
      tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-[#9CA3AF]">Consultando agentes registrados...</td></tr>`;

      try {
        const params = {};
        if (searchInput?.value?.trim()) params.hostname = searchInput.value.trim();
        if (statusSelect?.value) params.status_filter = statusSelect.value;

        const data = await apiGet("/api/v1/agents", params);
        allAgents = data.agents || [];

        if (kpiHealthy) kpiHealthy.textContent = data.summary?.healthy ?? 0;
        if (kpiDelayed) kpiDelayed.textContent = data.summary?.delayed ?? 0;
        if (kpiOffline) kpiOffline.textContent = data.summary?.offline ?? 0;
        if (kpiTotal) kpiTotal.textContent = data.summary?.total ?? 0;

        renderAgentsTable(allAgents, data.total || 0);
      } catch (err) {
        console.error("Error al cargar agentes:", err);
        tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-[#DC2626]">Error al conectar con la API de Agentes.</td></tr>`;
      }
    }

    function renderAgentsTable(agents, total) {
      tbody.innerHTML = "";
      if (summaryEl) summaryEl.textContent = `Mostrando ${agents.length} de ${total} agentes registrados`;

      if (agents.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-[#9CA3AF]">Sin agentes registrados para los filtros seleccionados.</td></tr>`;
        return;
      }

      agents.forEach((ag) => {
        const tr = document.createElement("tr");
        tr.className = "hover:bg-[#F9FAFB] transition";

        const st = (ag.status || "offline").toLowerCase();
        const badgeClass = STATUS_BADGES[st] || STATUS_BADGES.offline;
        const lastSeen = ag.last_seen_at ? new Date(ag.last_seen_at).toISOString().replace("T", " ").slice(0, 19) : "Sin reporte";

        tr.innerHTML = `
          <td class="py-3 px-4 font-semibold text-[#111827]">
            ${ag.hostname}
            <span class="block text-[10px] font-mono text-[#9CA3AF]">${ag.id}</span>
          </td>
          <td class="py-3 px-4 font-mono text-[11px] text-[#4B5563]">${ag.ip_address}</td>
          <td class="py-3 px-4 text-[#374151]">${ag.os_info}</td>
          <td class="py-3 px-4 text-center font-mono text-[11px]">${ag.agent_version}</td>
          <td class="py-3 px-4 font-mono text-[11px] text-[#6B7280]">${lastSeen}</td>
          <td class="py-3 px-4 text-center">
            <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold ${badgeClass}">${st.toUpperCase()}</span>
          </td>
          <td class="py-3 px-4 text-center">
            <button type="button" class="px-3 py-1 rounded-full bg-[#E5E7EB] text-[#111827] text-[11px] hover:bg-[#D1D5DB] transition" data-view-agent="${ag.id}">
              Telemetría
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      tbody.querySelectorAll("[data-view-agent]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-view-agent");
          openAgentModal(id);
        });
      });
    }

    async function openAgentModal(agentId) {
      if (!modal || !agentId) return;
      modal.querySelector("[data-modal-agent-id]").textContent = agentId;
      modal.querySelector("[data-modal-agent-host]").textContent = "Cargando...";
      modal.classList.remove("hidden");
      modal.classList.add("grid");

      try {
        const ag = await apiGet(`/api/v1/agents/${agentId}`);
        modal.querySelector("[data-modal-agent-host]").textContent = ag.hostname;
        modal.querySelector("[data-modal-agent-ver]").textContent = ag.agent_version;
        modal.querySelector("[data-modal-agent-os]").textContent = ag.os_info;
        modal.querySelector("[data-modal-agent-ip]").textContent = ag.ip_address;
        modal.querySelector("[data-modal-agent-meta]").textContent = JSON.stringify(ag.metadata_json || {});

        const stBadge = modal.querySelector("[data-modal-agent-status]");
        if (stBadge) {
          const st = (ag.status || "offline").toLowerCase();
          stBadge.textContent = st.toUpperCase();
          stBadge.className = `inline-block px-2 py-0.5 rounded text-[10px] font-semibold ${STATUS_BADGES[st] || STATUS_BADGES.offline}`;
        }

        const eventsEl = modal.querySelector("[data-modal-agent-events]");
        if (eventsEl) {
          eventsEl.textContent = JSON.stringify(ag.recent_telemetry_events || [], null, 2);
        }
      } catch (err) {
        console.error("Error al obtener detalle del agente:", err);
      }
    }

    modalCloseBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        modal.classList.add("hidden");
        modal.classList.remove("grid");
      });
    });

    refreshBtn?.addEventListener("click", loadAgents);
    searchInput?.addEventListener("input", loadAgents);
    statusSelect?.addEventListener("change", loadAgents);

    loadAgents();
  </script>
</DashboardLayout>
