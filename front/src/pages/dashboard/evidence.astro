---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import HeaderBar from "../../components/dashboard/HeaderBar.astro";
---

<DashboardLayout pageTitle="SentinelX SIEM – Explorador de Evidencia Forense (MinIO S3)">
  <HeaderBar
    title="Explorador de Evidencia Forense"
    subtitle="Inspección inmutable de evidencia original (S3) y verificación de Hash SHA-256."
    showFilters={false}
  />

  <section class="flex-1 px-8 py-6 space-y-6">
    <!-- FILTROS DE RUTA FORENSE S3 -->
    <div class="rounded-2xl border border-[#E5E7EB] bg-white p-6 shadow-sm flex flex-col md:flex-row gap-3 items-center justify-between">
      <div class="flex flex-wrap gap-2 text-xs items-center w-full md:w-auto">
        <span class="font-semibold text-[#111827]">Prefijo S3:</span>
        <code class="px-2 py-1 rounded bg-[#F3F4F6] text-[#E67E22] font-mono text-[11px]" data-s3-prefix>sentinelx-evidence/tenant/</code>
      </div>
      <div class="flex gap-2 w-full md:w-auto">
        <input type="text" placeholder="Buscar por clave de objeto S3..." class="h-9 px-3 rounded-lg border border-[#E5E7EB] text-xs flex-1 md:w-64" data-evidence-search-input />
        <button type="button" class="h-9 px-4 rounded-lg bg-[#10B981] text-white text-xs font-medium hover:bg-[#059669] transition" data-evidence-refresh>
          🔄 Actualizar
        </button>
      </div>
    </div>

    <!-- TABLA DE EVIDENCIA S3 -->
    <div class="rounded-2xl border border-[#E5E7EB] bg-white shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-[#E5E7EB] flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold text-[#111827]">Objetos de Evidencia Inmutable Almacenados</h2>
          <p class="text-xs text-[#6B7280]" data-evidence-summary>Cargando catálogo S3...</p>

        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-xs">
          <thead>
            <tr class="bg-[#FAFAFB] text-[#6B7280] border-b border-[#E5E7EB]">
              <th class="py-3 px-4 text-left">Objeto / Clave S3</th>
              <th class="py-3 px-4 text-center">Tamaño</th>
              <th class="py-3 px-4 text-left">Fecha Creación</th>
              <th class="py-3 px-4 text-left">Firma Hash SHA-256</th>
              <th class="py-3 px-4 text-center">Integridad Forense</th>
              <th class="py-3 px-4 text-center">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#F3F4F6] text-[#374151]" data-evidence-table-body>
            <!-- Filas dinámicas -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- MODAL INSPECCIÓN CONTENIDO CRUDO S3 -->
    <div id="evidence-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs hidden place-items-center p-4">
      <div class="w-full max-w-4xl max-h-[90vh] bg-white rounded-2xl shadow-xl flex flex-col overflow-hidden">
        <div class="px-6 py-4 border-b border-[#E5E7EB] flex justify-between items-center bg-[#FAFAFB]">
          <h3 class="text-sm font-semibold text-[#111827]">Inspección Forense de Evidencia Cruda (MinIO S3)</h3>
          <button type="button" class="text-xs text-[#6B7280] hover:text-[#111827]" data-evidence-modal-close>✕ Cerrar</button>
        </div>

        <div class="p-6 space-y-4 overflow-y-auto">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 bg-[#ECFDF5] p-4 rounded-xl border border-[#A7F3D0] text-xs">
            <div><span class="text-[#047857] block font-semibold">Clave S3:</span><code data-modal-key class="text-[11px] font-mono break-all">—</code></div>
            <div><span class="text-[#047857] block font-semibold">SHA-256 Verificado:</span><code data-modal-sha class="text-[10px] font-mono break-all">—</code></div>
            <div><span class="text-[#047857] block font-semibold">Estado Forense:</span><span data-modal-status class="inline-block px-2 py-0.5 rounded bg-[#10B981] text-white font-semibold text-[10px]">VERIFICADO</span></div>
          </div>

          <div>
            <h4 class="text-xs font-semibold text-[#111827] mb-1">Contenido Descomprimido del Log Original</h4>
            <pre class="bg-[#111827] text-[#6EE7B7] p-4 rounded-xl text-[11px] font-mono overflow-x-auto max-h-96 whitespace-pre-wrap" data-modal-raw-content>Cargando evidencia...</pre>
          </div>
        </div>

        <div class="px-6 py-3 border-t border-[#E5E7EB] flex justify-end bg-[#FAFAFB]">
          <button type="button" class="px-4 py-2 rounded-full border border-[#D1D5DB] text-[12px] text-[#374151] hover:bg-[#F3F4F6]" data-evidence-modal-close>
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck
    import { apiGet } from "../../lib/api.js";

    const tbody = document.querySelector("[data-evidence-table-body]");
    const summaryEl = document.querySelector("[data-evidence-summary]");
    const prefixEl = document.querySelector("[data-s3-prefix]");
    const refreshBtn = document.querySelector("[data-evidence-refresh]");
    const searchInput = document.querySelector("[data-evidence-search-input]");

    const modal = document.getElementById("evidence-modal");
    const modalCloseBtns = document.querySelectorAll("[data-evidence-modal-close]");

    let allObjects = [];

    async function loadEvidenceCatalog() {
      if (!tbody) return;
      tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-[#9CA3AF]">Consultando catálogo de evidencia MinIO S3...</td></tr>`;

      try {
        const data = await apiGet("/api/v1/evidence/explore");
        allObjects = data.objects || [];
        if (prefixEl) prefixEl.textContent = data.prefix || "sentinelx-evidence/";
        renderObjects(allObjects);
      } catch (err) {
        console.error("Error al cargar catálogo de evidencia:", err);
        tbody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-[#DC2626]">Error al conectar con MinIO S3 API.</td></tr>`;
      }
    }

    function renderObjects(objects) {
      tbody.innerHTML = "";
      if (summaryEl) summaryEl.textContent = `Mostrando ${objects.length} paquetes de evidencia forense`;

      if (objects.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-[#9CA3AF]">Sin paquetes de evidencia registrados en este tenant.</td></tr>`;
        return;
      }

      objects.forEach((obj, idx) => {
        const tr = document.createElement("tr");
        tr.className = "hover:bg-[#F9FAFB] transition";

        const sizeKb = (obj.size_bytes / 1024).toFixed(1) + " KB";
        const created = obj.created_at ? new Date(obj.created_at).toISOString().replace("T", " ").slice(0, 19) : "—";
        const shaShort = obj.sha256 ? obj.sha256.slice(0, 16) + "…" : "—";

        tr.innerHTML = `
          <td class="py-3 px-4 font-mono text-[11px] font-semibold text-[#111827]">${obj.object_key}</td>
          <td class="py-3 px-4 text-center font-mono text-[11px]">${sizeKb}</td>
          <td class="py-3 px-4 text-[#6B7280]">${created}</td>
          <td class="py-3 px-4 font-mono text-[10px] text-[#4B5563]">${shaShort}</td>
          <td class="py-3 px-4 text-center">
            <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#DCFCE7] text-[#166534]">INMUTABLE</span>
          </td>
          <td class="py-3 px-4 text-center">
            <button type="button" class="px-3 py-1 rounded-full bg-[#10B981] text-white text-[11px] hover:bg-[#059669] transition" data-view-key="${obj.object_key}">
              Ver Contenido
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      tbody.querySelectorAll("[data-view-key]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.getAttribute("data-view-key");
          openObjectModal(key);
        });
      });
    }

    async function openObjectModal(objectKey) {
      if (!modal || !objectKey) return;
      modal.querySelector("[data-modal-key]").textContent = objectKey;
      modal.querySelector("[data-modal-sha]").textContent = "Verificando...";
      modal.querySelector("[data-modal-raw-content]").textContent = "Descargando y descomprimiendo paquete gzip desde MinIO...";
      modal.classList.remove("hidden");
      modal.classList.add("grid");

      try {
        const data = await apiGet(`/api/v1/evidence/object?object_key=${encodeURIComponent(objectKey)}`);
        modal.querySelector("[data-modal-sha]").textContent = data.sha256_expected || "SHA-256 Forense Válido";
        modal.querySelector("[data-modal-raw-content]").textContent = data.raw_content || "—";
      } catch (err) {
        console.error("Error al obtener objeto S3:", err);
        modal.querySelector("[data-modal-raw-content]").textContent = "Error al descargar o verificar la evidencia S3.";
      }
    }

    modalCloseBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        modal.classList.add("hidden");
        modal.classList.remove("grid");
      });
    });

    refreshBtn?.addEventListener("click", loadEvidenceCatalog);

    // Auto-open if query param object_key exists
    const urlKey = new URLSearchParams(window.location.search).get("object_key");
    if (urlKey) {
      openObjectModal(urlKey);
    }

    loadEvidenceCatalog();
  </script>
</DashboardLayout>
