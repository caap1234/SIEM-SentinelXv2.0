---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import HeaderBar from "../../components/dashboard/HeaderBar.astro";
import StatsCard from "../../components/dashboard/StatsCard.astro";
import ActivityChart from "../../components/dashboard/ActivityChart.astro";
import SuspiciousIPsCard from "../../components/dashboard/SuspiciousIPsCard.astro";
import RecentEventsCard from "../../components/dashboard/RecentEventsCard.astro";
import SystemStatusCard from "../../components/dashboard/SystemStatusCard.astro";

---


<DashboardLayout>
  <HeaderBar
    title="Dashboard"
    subtitle="Visión general de alertas, incidentes y entidades en SentinelX SIEM (v2)."
    showFilters={true}
    showServerFilter={true}
    showDateFilter={true}
    showSeverityFilter={true}
  />

  <section class="flex-1 px-8 py-6 space-y-6">
    <!-- Métricas principales SOC -->
    <div class="grid gap-4 md:grid-cols-6">
      <StatsCard
        statKey="events_received"
        label="Eventos recibidos"
        value="—"
        helper="Últimas 24h"
      />
      <StatsCard
        statKey="events_processed"
        label="Eventos procesados"
        value="—"
        helper="En NATS Stream"
      />
      <StatsCard
        statKey="events_indexed"
        label="Eventos indexados"
        value="—"
        helper="OpenSearch Stream"
      />
      <StatsCard
        statKey="alerts_active"
        label="Alertas activas"
        value="—"
        helper="Pendientes"
      />
      <StatsCard
        statKey="incidents_open"
        label="Incidentes abiertos"
        value="—"
        helper="En investigación"
      />
      <StatsCard
        statKey="agents_online"
        label="Agentes online"
        value="—"
        helper="Servidores Linux"
      />
    </div>


    <!-- Dos columnas principales -->
    <div class="grid gap-4 md:grid-cols-2">
      <div class="flex flex-col gap-4">
        <ActivityChart />
        <RecentEventsCard />
      </div>

      <div class="flex flex-col gap-4">
        <SuspiciousIPsCard />
        <SystemStatusCard />
      </div>
    </div>
  </section>

  <script>
    import { getDashboardSummary } from "../../lib/dashboard.js";

    async function loadKpis() {
      try {
        const data = await getDashboardSummary();

        /** @type {{key:string; value:number|string; helper?:string;}[]} */
        const stats = [
          {
            key: "events_received",
            value: data?.events_received ?? 0,
            helper: "Últimas 24h",
          },
          {
            key: "events_processed",
            value: data?.events_processed ?? 0,
            helper: "En NATS Stream",
          },
          {
            key: "events_indexed",
            value: data?.events_indexed ?? 0,
            helper: "OpenSearch Stream",
          },
          {
            key: "alerts_active",
            value: data?.alerts_active ?? 0,
            helper: "Pendientes",
          },
          {
            key: "incidents_open",
            value: data?.incidents_open ?? 0,
            helper: "En investigación",
          },
          {
            key: "agents_online",
            value: data?.agents_online ?? 0,
            helper: "Servidores Linux",
          },
        ];

        stats.forEach((item) => {
          const el = document.querySelector(`[data-stat-key="${item.key}"]`);
          if (!el) return;

          const valueEl = el.querySelector("[data-stat-value]");
          const helperEl = el.querySelector("[data-stat-helper]");

          if (valueEl) {
            const v =
              typeof item.value === "number"
                ? item.value.toLocaleString("es-MX")
                : String(item.value ?? "—");
            valueEl.textContent = v;
          }

          if (helperEl && item.helper) {
            helperEl.textContent = item.helper;
          }
        });
      } catch (err) {
        console.error("Error al cargar KPIs del Dashboard SOC con cliente API:", err);
      }
    }

    loadKpis();
    setInterval(loadKpis, 15000); // Polling configurable cada 15s
  </script>


    function getInitialFilters() {
  </script>


</DashboardLayout>
